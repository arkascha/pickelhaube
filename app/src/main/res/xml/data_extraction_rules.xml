<?xml version="1.0" encoding="utf-8"?>
<!--
    Since Android 12 android:allowBackup="false" no longer stops a transfer from phone to phone,
    so nothing of the app's data is copied there either, just as nothing goes to the cloud backup.
    (The password could not be decrypted on the other phone anyway: its key stays in this phone's Keystore.)
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
