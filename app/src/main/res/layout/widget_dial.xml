<?xml version="1.0" encoding="utf-8"?>
<!--
    Dial widget: the logo, tilted, sticking out a little over the top of the frame at its right corner
    (not to the side: launchers clip a widget at the edge of the home screen) – a tap on it, or on the
    title, opens the widget's setup; in the frame its title and the numbers chosen for it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@android:id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/widget_logo_overhang"
        android:background="@drawable/widget_background"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="32dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="44dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#99000000"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="@color/widget_text"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <ListView
            android:id="@+id/widget_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp" />

        <TextView
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="8dp"
            android:textColor="@color/widget_text"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_logo"
        android:contentDescription="@string/widget_edit"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="2dp"
        android:rotation="14"
        android:src="@drawable/widget_logo" />
</FrameLayout>
