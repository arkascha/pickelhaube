<?xml version="1.0" encoding="utf-8"?>
<!--
    The dial widget's frame in its transparent look: the wallpaper shows through, a faint tint and a
    thin light outline hold title and rows together.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_frame_transparent" />
    <stroke
        android:width="1.5dp"
        android:color="@color/widget_frame_outline" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
