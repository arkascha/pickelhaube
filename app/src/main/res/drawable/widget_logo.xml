<?xml version="1.0" encoding="utf-8"?>
<!--
    The app icon as a round badge with a white ring, for the dial widget. The icon's foreground is drawn
    on 108 units with its picture in the middle 72: the negative insets enlarge it, leaving a
    little room inside the ring.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/widget_logo_ring" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="@color/ic_launcher_background" />
        </shape>
    </item>
    <item
        android:bottom="-5dp"
        android:drawable="@drawable/ic_launcher_foreground"
        android:left="-5dp"
        android:right="-5dp"
        android:top="-5dp" />
</layer-list>
