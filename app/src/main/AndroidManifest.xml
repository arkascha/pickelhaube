<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To notice network changes and find the gateway (= the FritzBox of the current network). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Optional: show the phone's own contacts in the phone book view (asked at runtime). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Optional: offer the numbers dialled, received and missed with the phone's own telephony app (asked at runtime). -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pickelhaube">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Lets Pickelhaube be chosen when tapping a phone number elsewhere (Contacts, browser, ...). -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!--
            The dialer as started by the entries of the launcher icon's long-press menu: not exported, so no
            other app can start it – only an intent sent here may dial without the green button being pressed.
        -->
        <activity-alias
            android:name=".LauncherShortcut"
            android:exported="false"
            android:targetActivity=".MainActivity" />

        <!-- Launcher shortcut "Call forwarding": switches it without opening the app; invisible. -->
        <activity
            android:name=".shortcut.DeflectionShortcutActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Quick settings tiles: open the dialer, open it with the number dialled last, and switch a call forwarding. -->
        <service
            android:name=".tile.DialerTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_pickelhaube"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".tile.RedialTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_pickelhaube"
            android:label="@string/tile_redial"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".tile.DeflectionTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_pickelhaube"
            android:label="@string/tile_deflection"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <!-- A switch: on or off, as screen readers say. -->
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
    </application>
</manifest>
