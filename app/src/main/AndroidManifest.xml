<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To notice network changes and find the gateway (= the FritzBox of the current network). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Optional: show the phone's own contacts in the phone book view (asked at runtime). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Optional: "Call via FRITZ!Box" rows in the phone's contacts (ContactActions; asked at runtime). -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- Only for the daily job that keeps those rows in step to survive a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- READ_CALL_LOG only in the "full" flavour, see src/full/AndroidManifest.xml. -->

    <!-- tools:ignore UnusedAttribute: localeConfig (the in-app language list in Android's settings)
         only takes effect from Android 13 on; older versions ignore it, which is fine.
         tools:ignore DataExtractionRules: no fullBackupContent is needed for Android before 12,
         allowBackup="false" rules out any backup there; from 12 on the extraction rules exclude everything. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pickelhaube"
        tools:ignore="UnusedAttribute,DataExtractionRules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Lets Pickelhaube be chosen when tapping a phone number elsewhere (Contacts, browser, ...). -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>

            <!-- Offered under "Share" for text (an email, a signature, a web page): its phone number into the dialer. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- A "Call via FRITZ!Box" row tapped in the contacts app (ContactActions): its number into the dialer. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/vnd.org.rustygnome.pickelhaube.call" />
            </intent-filter>
        </activity>

        <!--
            The dialer as started by the entries of the launcher icon's long-press menu: not exported, so no
            other app can start it – only an intent sent here may dial without the green button being pressed.
        -->
        <activity-alias
            android:name=".LauncherShortcut"
            android:exported="false"
            android:targetActivity=".MainActivity" />

        <!-- Launcher shortcut "Call forwarding": switches it without opening the app; no window. -->
        <activity
            android:name=".shortcut.DeflectionShortcutActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Launcher shortcut showing the reachable FRITZ!Box: looks for it again; no window. -->
        <activity
            android:name=".shortcut.BoxShortcutActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Quick settings tiles: open the dialer, open it with the number dialled last, and switch a call forwarding. -->
        <service
            android:name=".tile.DialerTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_pickelhaube"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Home screen widget with numbers chosen by hand; its rows come from the service below. -->
        <receiver
            android:name=".widget.DialWidget"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_dial" />
        </receiver>
        <!-- Started by the launcher when the widget is placed: it has to be exported for that. -->
        <activity
            android:name=".widget.WidgetSetupActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <service
            android:name=".tile.RedialTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_pickelhaube"
            android:label="@string/tile_redial"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".tile.DeflectionTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_pickelhaube"
            android:label="@string/tile_deflection"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <!-- A switch: on or off, as screen readers say. -->
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- "Call via FRITZ!Box" in the phone's contacts: the account for the rows, its stand-in sync
             adapter (which tells the contacts app how to show them), and the job keeping them in step. -->
        <service
            android:name=".contacts.AuthenticatorService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/authenticator" />
        </service>
        <service
            android:name=".contacts.ContactsSyncService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/sync_contacts" />
            <meta-data
                android:name="android.provider.CONTACTS_STRUCTURE"
                android:resource="@xml/contacts" />
        </service>
        <service
            android:name=".contacts.ContactActionsJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
